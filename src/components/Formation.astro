---
// Archivo: src/components/Formation.astro
import portafolio from '../json/portafolio.json';

const formacionData = portafolio.formacion;
---

<section id="formacion-section" class="formacion py-12 bg-gray-100 flex justify-center" data-agent-section="education">
  <div class="card w-full max-w-4xl p-6 sm:p-8 bg-white rounded-lg shadow-xl">
    <h2 class="text-2xl font-bold mb-6 text-gray-900 text-center sm:text-left">Formación Profesional</h2>
    <div class="formacion-profesional space-y-6">
      {formacionData.profesional.map((formacion) => (
        <article class="formacion-card p-6 bg-gray-50 rounded-lg shadow-sm border border-gray-100">
          <h3 class="formacion-titulo text-xl font-bold text-gray-900">{formacion.titulo}</h3>
          <p class="formacion-institucion text-blue-800 font-semibold mb-1">
            {formacion.institucion} - <span class="text-gray-700 font-normal">{formacion.lugar}</span>
          </p>
          <p class="formacion-fecha text-gray-600 text-sm font-medium">{formacion.fecha}</p>
        </article>
      ))}
    </div>

    <h2 class="text-2xl font-bold mt-12 mb-6 text-gray-900 text-center sm:text-left">Cursos y Certificaciones</h2>
    <div class="cursos grid grid-cols-1 md:grid-cols-2 gap-6">
      {formacionData.cursos.map((curso) => {
        const certLink = curso.link.startsWith('http') || curso.link.startsWith('/') 
          ? curso.link 
          : '/' + curso.link;
        return (
          <article class="curso-card p-6 bg-gray-50 rounded-lg shadow-sm border border-gray-100 flex flex-col justify-between">
            <div class="mb-4">
              <h3 class="curso-titulo text-lg font-bold text-gray-900">{curso.titulo}</h3>
              <p class="curso-plataforma text-emerald-800 font-bold text-sm mt-1">{curso.plataforma}</p>
            </div>
            <a 
              href={certLink} 
              class="boton-certificado px-4 py-2.5 bg-blue-800 text-white rounded-lg hover:bg-blue-900 transition-colors text-center font-medium min-h-[44px] flex items-center justify-center self-start text-sm shadow-sm" 
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ver certificado oficial de ${curso.titulo}`}
              data-agent-action="view-certificate"
            >
              Ver Certificado
            </a>
          </article>
        );
      })}
    </div>
  </div>
</section>
