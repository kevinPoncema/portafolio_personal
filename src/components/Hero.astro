---
import { Image } from 'astro:assets';
import portafolio from '../json/portafolio.json';
import profilePhoto from '../assets/images/foto_fea2.jpg';

const { sobre_mi } = portafolio;
const emailUrl = sobre_mi.email && sobre_mi.email.includes('@') 
  ? (sobre_mi.email.startsWith('mailto:') ? sobre_mi.email : `mailto:${sobre_mi.email}`)
  : 'mailto:ps12kevin@gmail.com';
---

<section id="hero-intro" class="w-full bg-gray-100 py-12" data-agent-section="hero">
  <div class="container mx-auto flex flex-col items-center">
    <div class="w-32 h-32 rounded-full bg-gray-200 shadow-md mb-6 flex items-center justify-center overflow-hidden">
      <Image
        src={profilePhoto}
        alt="Foto de perfil de Kevin Ponce"
        width={128}
        height={128}
        widths={[128, 256]}
        sizes="128px"
        format="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="rounded-full w-full h-full object-cover"
      />
    </div>
    <div class="bg-white shadow-lg rounded-lg p-6 max-w-xl w-full text-center">
      <h1 class="text-2xl font-bold text-gray-900 mb-2">{sobre_mi.titulo}</h1>
      <h2 class="text-xl font-semibold text-gray-700 mb-4">{sobre_mi.nombre}</h2>
      <p class="text-gray-700 mb-4 leading-relaxed">{sobre_mi.descripcion}</p>
      <div class="flex justify-center space-x-3 mt-4" id="hero-actions">
        {sobre_mi.github && (
          <a
            id="hero-github-link"
            href={sobre_mi.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center w-11 h-11 rounded-full text-gray-700 hover:text-blue-800 hover:bg-gray-100 transition-colors duration-200"
            aria-label="Perfil de GitHub de Kevin Ponce"
            data-agent-action="github"
          >
            <img src="/icons/github.svg" alt="" aria-hidden="true" class="w-6 h-6" width="24" height="24" loading="lazy" decoding="async" />
          </a>
        )}
        <a
          id="hero-email-link"
          href={emailUrl}
          class="inline-flex items-center justify-center w-11 h-11 rounded-full text-gray-700 hover:text-blue-800 hover:bg-gray-100 transition-colors duration-200"
          aria-label="Enviar correo electrónico a Kevin Ponce"
          data-agent-action="email"
        >
          <img src="/icons/gemail.svg" alt="" aria-hidden="true" class="w-6 h-6" width="24" height="24" loading="lazy" decoding="async" />
        </a>
      </div>
    </div>
  </div>
</section>
