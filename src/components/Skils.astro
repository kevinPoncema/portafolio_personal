---
// Archivo: src/components/Skils.astro
import portafolio from '../json/portafolio.json';
---

<section id="habilidades-section" class="w-full bg-gray-100 py-12" data-agent-section="skills">
  <div class="container mx-auto px-4">
    <!-- Sección de Habilidades Técnicas -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Habilidades Técnicas</h2>
      <div class="flex flex-wrap justify-center gap-y-6" id="skills-tech-list">
        {portafolio.habilidades.tecnologias.map((tecnologia) => {
          const iconSrc = tecnologia.ruta.startsWith('/') ? tecnologia.ruta : '/' + tecnologia.ruta;
          return (
            <div class="w-1/2 sm:w-1/3 md:w-1/4 p-4 text-center" key={tecnologia.nombre}>
              <img 
                src={iconSrc} 
                alt={tecnologia.nombre} 
                class="w-16 h-16 mx-auto mb-2 object-contain"
                width="64"
                height="64"
                loading="lazy"
                decoding="async"
              />
              <p class="text-gray-800 font-semibold">{tecnologia.nombre}</p>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Sección de Habilidades Blandas -->
    <div>
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Habilidades Blandas</h2>
      <div class="flex flex-wrap justify-center gap-3 max-w-xl mx-auto" id="skills-soft-list">
        {portafolio.habilidades.blandas.map((habilidad) => (
          <span 
            class="inline-block bg-white px-5 py-2.5 rounded-lg shadow-sm border border-gray-200 text-gray-800 font-semibold text-sm"
            key={habilidad.nombre}
          >
            {habilidad.nombre}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 3rem 0;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
</style>
