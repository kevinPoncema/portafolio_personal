---
// Archivo: src/components/ImageCarrusel.astro
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
  imagenes: string[];
  altText: string;
}

const { imagenes, altText } = Astro.props;

// Glob enfocado exclusivamente en proyectos para no cargar la foto de perfil del Hero
const assetImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/projects/**/*.{jpeg,jpg,png,webp}');

const resolvedImages = await Promise.all(
  (imagenes || []).map(async (imagen) => {
    const cleanPath = imagen.replace(/^\//, '');
    const key = `/src/assets/${cleanPath}`;
    if (assetImages[key]) {
      const mod = await assetImages[key]();
      return {
        isOptimized: true,
        src: mod.default,
        originalUrl: '/' + cleanPath,
      };
    }
    return {
      isOptimized: false,
      src: '/' + cleanPath,
      originalUrl: '/' + cleanPath,
    };
  })
);
---

<div class="image-carousel-container relative w-full">
  <div class="carousel-wrapper group relative overflow-hidden rounded-md aspect-[16/9] sm:aspect-[400/220] w-full h-[220px]">
    <div class="carousel-images flex transition-transform duration-300 ease-in-out w-full h-full">
      {resolvedImages.map((imgItem, index) => (
        <div class="carousel-slide w-full min-w-full flex-shrink-0 h-full" key={index}>
          {imgItem.isOptimized ? (
            <Image
              src={imgItem.src as ImageMetadata}
              alt={`${altText} - Imagen ${index + 1}`}
              width={400}
              height={220}
              widths={[320, 400, 640]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
              format="webp"
              loading="lazy"
              decoding="async"
              class="w-full h-[220px] object-cover cursor-pointer hover:opacity-90 transition-opacity duration-200"
              data-modal-img={imgItem.originalUrl}
              data-modal-alt={`${altText} - Imagen ${index + 1}`}
            />
          ) : (
            <img
              src={imgItem.src as string}
              alt={`${altText} - Imagen ${index + 1}`}
              width="400"
              height="220"
              loading="lazy"
              decoding="async"
              class="w-full h-[220px] object-cover cursor-pointer hover:opacity-90 transition-opacity duration-200"
              data-modal-img={imgItem.originalUrl}
              data-modal-alt={`${altText} - Imagen ${index + 1}`}
            />
          )}
        </div>
      ))}
    </div>
    
    <!-- Controles de navegación con área táctil accesible (mínimo 44x44px) -->
    {imagenes.length > 1 && (
      <>
        <button 
          type="button"
          class="carousel-btn carousel-btn-prev absolute left-2 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 w-11 h-11 p-2.5 rounded-full shadow-md transition-opacity duration-200 flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-blue-600 z-10 opacity-0 group-hover:opacity-100 active:scale-95"
          aria-label={`Imagen anterior de ${altText}`}
        >
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        
        <button 
          type="button"
          class="carousel-btn carousel-btn-next absolute right-2 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 w-11 h-11 p-2.5 rounded-full shadow-md transition-opacity duration-200 flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-blue-600 z-10 opacity-0 group-hover:opacity-100 active:scale-95"
          aria-label={`Imagen siguiente de ${altText}`}
        >
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </>
    )}
  </div>
  
  <!-- Indicadores con área táctil accesible de 44x44px -->
  {imagenes.length > 1 && (
    <div class="carousel-indicators flex justify-center items-center gap-1 mt-3" role="tablist" aria-label={`Diapositivas de ${altText}`}>
      {imagenes.map((_, index) => (
        <button 
          type="button"
          class="indicator-dot group flex items-center justify-center w-11 h-11 p-0 bg-transparent border-0 cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-600 rounded-full"
          data-index={index}
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          aria-label={`Ir a imagen ${index + 1} de ${imagenes.length}`}
          key={index}
        >
          <span class={`indicator-inner block rounded-full transition-all duration-200 ${index === 0 ? 'w-3 h-3 bg-blue-600' : 'w-2.5 h-2.5 bg-gray-400 group-hover:bg-gray-600'}`} />
        </button>
      ))}
    </div>
  )}
</div>