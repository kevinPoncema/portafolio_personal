---
// Archivo: src/components/Experience.astro
import portafolio from '../json/portafolio.json';

const { experiencia } = portafolio;
---

<section id="experiencia-section" class="experiencia-laboral py-12 flex justify-center bg-white" data-agent-section="experience">
  <div class="w-full max-w-5xl px-4">
    <h2 class="text-3xl font-bold mb-8 text-center text-gray-900">Experiencia Laboral y Freelance</h2>
    <div class="timeline relative pl-6 sm:pl-10 text-left">
      <div class="absolute left-3 sm:left-5 top-0 bottom-0 w-0.5 bg-amber-500" aria-hidden="true"></div>
      {experiencia.map((trabajo, index) => (
        <article key={index} class="timeline-item relative mb-10 pl-6 sm:pl-8">
          <div class="timeline-icon absolute -left-1 sm:left-3 top-1.5 w-3.5 h-3.5 bg-amber-600 border-2 border-white rounded-full shadow-sm" aria-hidden="true"></div>
          <div class="timeline-content">
            <h3 class="puesto text-xl font-bold text-amber-800 mb-1">
              {trabajo.title}
            </h3>
            <p class="empresa font-semibold text-gray-800 text-base mb-1">{trabajo.company}</p>
            <time class="fecha text-sm text-gray-600 mb-3 block font-medium">{trabajo.date}</time>
            <p class="descripcion text-gray-700 leading-relaxed text-sm sm:text-base">{trabajo.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline-item:last-child {
    margin-bottom: 0;
  }
</style>
