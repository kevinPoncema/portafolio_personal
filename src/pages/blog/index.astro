---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Blog de KevinPonceDev — Artículos sobre desarrollo web, herramientas y buenas prácticas." />
    <title>Blog | KevinPonceDev</title>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <Header />

    <main class="pt-20 pb-16">
      <!-- Hero del blog -->
      <div class="bg-blue-800 text-white py-16 text-center">
        <div class="container mx-auto px-4">
          <h1 class="text-4xl md:text-5xl font-bold mb-4">Blog</h1>
          <p class="text-blue-200 text-lg max-w-xl mx-auto">
            Artículos sobre desarrollo web, herramientas y cosas que aprendo en el camino.
          </p>
        </div>
      </div>

      <!-- Lista de posts -->
      <div class="container mx-auto px-4 max-w-4xl py-12">
        <div class="grid gap-8">
          {sortedPosts.map((post) => {
            const formattedDate = new Intl.DateTimeFormat('es-ES', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            }).format(post.data.pubDate);

            return (
              <article class="blog-card bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow duration-300">
                <a href={`/blog/${post.slug}`} class="block p-8">
                  <!-- Tags -->
                  <div class="flex flex-wrap gap-2 mb-4">
                    {post.data.tags.map((tag) => (
                      <span class="bg-blue-100 text-blue-700 text-xs font-semibold px-3 py-1 rounded-full">
                        #{tag}
                      </span>
                    ))}
                  </div>

                  <!-- Título -->
                  <h2 class="text-2xl font-bold text-gray-800 mb-3 hover:text-blue-700 transition-colors">
                    {post.data.title}
                  </h2>

                  <!-- Descripción -->
                  <p class="text-gray-600 text-base mb-5 leading-relaxed">
                    {post.data.description}
                  </p>

                  <!-- Footer de la card -->
                  <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-400 flex items-center gap-1">
                      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      {formattedDate}
                    </span>
                    <span class="text-blue-700 font-semibold text-sm flex items-center gap-1 group">
                      Leer más
                      <svg class="transform group-hover:translate-x-1 transition-transform" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>

        {sortedPosts.length === 0 && (
          <div class="text-center py-20 text-gray-400">
            <p class="text-2xl font-semibold mb-2">No hay posts todavía</p>
            <p>¡Próximamente!</p>
          </div>
        )}
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .blog-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .blog-card:hover {
    transform: translateY(-3px);
  }
</style>
