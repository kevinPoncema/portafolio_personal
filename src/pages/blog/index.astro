---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const siteUrl = "https://kevinponcedev.xyz";
const pageTitle = "Blog | KevinPonceDev";
const pageDescription = "Artículos técnicos sobre desarrollo backend, APIs RESTful, arquitectura y herramientas modernas por Kevin Ponce.";
const canonicalUrl = `${siteUrl}/blog`;
const ogImage = `${siteUrl}/images/foto_fea2.jpg`;

const schemaJson = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${canonicalUrl}#blog`,
  "name": "Blog de KevinPonceDev",
  "description": pageDescription,
  "url": canonicalUrl,
  "author": {
    "@type": "Person",
    "name": "Kevin David Ponce Machigua",
    "url": siteUrl
  }
};
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Básico -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="KevinPonceDev" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
  </head>

  <body class="bg-gray-50 min-h-screen text-gray-900 antialiased">
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:bg-blue-800 focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-white"
    >
      Saltar al contenido principal
    </a>

    <Header />

    <main id="main-content" class="pt-16 pb-16">
      <!-- Hero del blog -->
      <div class="bg-blue-800 text-white py-16 text-center">
        <div class="container mx-auto px-4">
          <h1 class="text-4xl md:text-5xl font-bold mb-4">Blog</h1>
          <p class="text-blue-100 text-lg max-w-xl mx-auto">
            Artículos sobre desarrollo web, herramientas y cosas que aprendo en el camino.
          </p>
        </div>
      </div>

      <!-- Lista de posts -->
      <div class="container mx-auto px-4 max-w-4xl py-12">
        <div class="grid gap-8">
          {sortedPosts.map((post) => {
            const formattedDate = new Intl.DateTimeFormat('es-ES', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            }).format(post.data.pubDate);

            return (
              <article class="blog-card bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow duration-300">
                <a href={`/blog/${post.slug}`} class="block p-8 focus:outline-none focus:ring-2 focus:ring-blue-600 rounded-2xl" aria-label={`Leer artículo: ${post.data.title}`}>
                  <!-- Tags -->
                  <div class="flex flex-wrap gap-2 mb-4">
                    {post.data.tags.map((tag) => (
                      <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-3 py-1 rounded-full">
                        #{tag}
                      </span>
                    ))}
                  </div>

                  <!-- Título -->
                  <h2 class="text-2xl font-bold text-gray-900 mb-3 hover:text-blue-800 transition-colors">
                    {post.data.title}
                  </h2>

                  <!-- Descripción -->
                  <p class="text-gray-700 text-base mb-5 leading-relaxed">
                    {post.data.description}
                  </p>

                  <!-- Footer de la card -->
                  <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600 font-medium flex items-center gap-1.5">
                      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      {formattedDate}
                    </span>
                    <span class="text-blue-800 font-semibold text-sm flex items-center gap-1 group">
                      Leer más
                      <svg class="transform group-hover:translate-x-1 transition-transform" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>

        {sortedPosts.length === 0 && (
          <div class="text-center py-20 text-gray-600">
            <p class="text-2xl font-semibold mb-2 text-gray-800">No hay posts todavía</p>
            <p>¡Próximamente!</p>
          </div>
        )}
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .blog-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .blog-card:hover {
    transform: translateY(-3px);
  }
</style>
