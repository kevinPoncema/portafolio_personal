---
// Archivo: src/components/Footer.astro
import portafolio from "../json/portafolio.json";
const { contactos } = portafolio;

const githubUrl = contactos[0]?.url || "https://github.com/kevinPoncema";
const gmailUrl = contactos[1]?.url || "mailto:ps12kevin@gmail.com";
const linkedin = contactos[2]?.url || "https://www.linkedin.com/in/kevin-david-ponce-machigua-75971a320/";
---

<footer class="bg-blue-800 py-8 w-full text-white" role="contentinfo">
  <div class="container mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-6">
    <nav class="flex flex-wrap justify-center text-center md:text-left gap-x-6 gap-y-2" aria-label="Navegación del pie de página">
      <a href="/#inicio" class="hover:text-blue-200 transition-colors py-2 text-sm">Inicio</a>
      <a href="/#habilidades" class="hover:text-blue-200 transition-colors py-2 text-sm">Habilidades</a>
      <a href="/#proyectos" class="hover:text-blue-200 transition-colors py-2 text-sm">Proyectos</a>
      <a href="/#experiencia" class="hover:text-blue-200 transition-colors py-2 text-sm">Experiencia</a>
      <a href="/#formacion" class="hover:text-blue-200 transition-colors py-2 text-sm">Formación</a>
      <a href="/blog" class="hover:text-blue-200 transition-colors py-2 text-sm">Blog</a>
      <a href="/#contacto" class="hover:text-blue-200 transition-colors py-2 text-sm">Contacto</a>
    </nav>

    <div class="flex items-center space-x-2">
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-white hover:text-blue-200 w-11 h-11 rounded-full flex items-center justify-center hover:bg-blue-700/60 transition-colors"
        aria-label="Perfil de GitHub de Kevin Ponce"
      >
        <img src="/icons/github.svg" alt="" aria-hidden="true" class="w-6 h-6" width="24" height="24" />
      </a>
      <a 
        href={gmailUrl} 
        class="text-white hover:text-blue-200 w-11 h-11 rounded-full flex items-center justify-center hover:bg-blue-700/60 transition-colors"
        aria-label="Enviar correo electrónico a Kevin Ponce"
      >
        <img src="/icons/gemail.svg" alt="" aria-hidden="true" class="w-6 h-6" width="24" height="24" />
      </a>
      <a 
        href={linkedin} 
        target="_blank" 
        rel="noopener noreferrer"
        class="text-white hover:text-blue-200 w-11 h-11 rounded-full flex items-center justify-center hover:bg-blue-700/60 transition-colors"
        aria-label="Perfil de LinkedIn de Kevin Ponce"
      >
        <img src="/icons/linkedink.svg" alt="" aria-hidden="true" class="w-6 h-6" width="24" height="24" />
      </a>
    </div>

    <div class="text-white text-lg font-bold flex items-center">
      <span class="text-white text-xl mr-2 font-mono" aria-hidden="true">&lt;/&gt;</span>
      <span>KevinPonceDev</span>
    </div>
  </div>
</footer>
